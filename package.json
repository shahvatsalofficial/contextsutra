{
  "name": "contextsutra",
  "version": "0.2.0",
  "description": "ContextSutra AI: local-first, keyless CLI that builds verifiable, privacy-aware project context capsules plus 12 portable agent skills for Claude Code, Cursor, Codex, Gemini CLI and Copilot.",
